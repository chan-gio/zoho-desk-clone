{
  "name": "zoho-desk-monolith",
  "version": "1.0.0",
  "description": "Zoho Desk Clone - Monolith Application",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "db:migrate": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:seed": "tsx src/database/seed.ts",
    "db:test": "node scripts/test-prisma.js",
    "pg:migrate": "psql -U \"$PGUSER\" -d \"$PGDATABASE\" -h \"$PGHOST\" -f ./database/postgres/migrations/001_init.sql",
    "pg:seed": "psql -U $PGUSER -d $PGDATABASE -f ./database/postgres/seeds/seed.sql",
    "mongo:migrate": "npx migrate-mongo up",
    "mongo:seed": "node ./database/mongo/seeds/seed.js"
  },
  "keywords": [
    "zoho",
    "desk",
    "ticketing",
    "monolith"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@as-integrations/express5": "^1.1.2",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/client": "^6.12.0",
    "@sendgrid/mail": "^8.1.5",
    "@types/uuid": "^10.0.0",
    "amqplib": "^0.10.8",
    "axios": "^1.7.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "graphql": "^16.11.0",
    "graphql-tools": "^9.0.20",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "migrate-mongo": "^12.1.3",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "prisma": "^6.12.0",
    "redis": "^5.6.0",
    "resend": "^4.6.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.7.0",
    "twilio": "^5.7.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.14",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "jest": "^30.0.4",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
