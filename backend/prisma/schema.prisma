generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  agent
  customer
}

// TicketStatus removed - using String instead

// Priority table thay thế cho enum
model Priority {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) // Hex color
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
  slas      SLA[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([order])
}

// Status table thay thế cho enum
model Status {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) // Hex color
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  columns   Column[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([order])
}

model Tenant {
  id         String    @id @default(uuid())
  name       String    @db.VarChar(255)
  avatar     String?   @db.VarChar(500) // URL của avatar trên Cloudinary
  createdAt  DateTime  @default(now())
  users      User[]
  departments Department[]
  tickets    Ticket[]
  columns    Column[]
  slas       SLA[]
  workflows  Workflow[]
  priorities Priority[]
  statuses   Status[]
}

model User {
  id           String   @id @default(uuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  username     String   @unique @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         UserRole @default(customer)
  isActive     Boolean  @default(true)
  avatar       String?  @db.VarChar(500) // URL của avatar trên Cloudinary
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  refreshToken String?
  resetPasswordToken String?
  resetPasswordTokenExpiry DateTime?
  ticketsCreated Ticket[] @relation("TicketCreator")
  ticketsAssigned Ticket[] @relation("TicketAssignee")
  comments     TicketComment[]
}

model Department {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String    @db.VarChar(100)
  description String?
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Column {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String    @db.VarChar(100)
  description String?
  order       Int       @default(0) // Thứ tự hiển thị của column
  color       String?   @db.VarChar(7) // Màu hex cho column (ví dụ: #FF5733)
  isDefault   Boolean   @default(false) // Column mặc định
  status      Status?   @relation(fields: [statusId], references: [id])
  statusId    String?   // ID của status tương ứng
  tickets     Ticket[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([order])
  @@index([statusId])
}

model Ticket {
  id          String    @id @default(uuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  tenantId    String
  title       String    @db.VarChar(255)
  description String?
  status      String       @default("open")
  priority    Priority?    @relation(fields: [priorityId], references: [id])
  priorityId  String?      // ID của priority
  afterId     String?   // ID của ticket đứng trước (null = ở trên cùng)
  column      Column?   @relation(fields: [columnId], references: [id])
  columnId    String?   // ID của column chứa ticket này
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  deletedAt   DateTime? 
  creator     User      @relation("TicketCreator", fields: [creatorId], references: [id])
  creatorId   String
  assignee    User?     @relation("TicketAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  department  Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  comments    TicketComment[]
  attachments Attachment[]

  @@index([tenantId])
  @@index([status])
  @@index([priorityId])
  @@index([columnId])
  @@index([afterId])
  @@index([createdAt])
  @@index([closedAt])
  @@index([deletedAt])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  ticketId   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  comment    String
  createdAt  DateTime @default(now())
  attachments Attachment[]
}

model Attachment {
  id           String   @id @default(uuid())
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  mimeType     String   @db.VarChar(100)
  size         Int
  filePath     String   @db.VarChar(255)
  url          String   @db.VarChar(500)
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId     String?
  comment      TicketComment? @relation(fields: [commentId], references: [id])
  commentId    String?
  uploadedBy   String
  tenantId     String
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model SLA {
  id             String   @id @default(uuid())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  tenantId       String
  name           String   @db.VarChar(100)
  description    String?
  responseTime   Int      @default(24) // hours
  resolutionTime Int      @default(72) // hours
  priority       Priority? @relation(fields: [priorityId], references: [id])
  priorityId     String?
  departmentId   String?
  isActive       Boolean  @default(true)
  escalationRules Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Workflow {
  id          String   @id @default(uuid())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tenantId    String
  name        String   @db.VarChar(100)
  description String?
  rules       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}
