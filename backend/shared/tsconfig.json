    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "../dist/shared/.tsbuildinfo"
  },
  "include": [
    "./**/*"
  ],
  "exclude": [
    "node_modules",
    "../dist"
  ]
}