# Server Configuration
# PORT=8080
# NODE_ENV=development
# FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/zoho_desk_db
MONGODB_URI=mongodb://localhost:27017/zoho_desk_mongodb
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload
# UPLOAD_PATH=./uploads
# MAX_FILE_SIZE=10485760

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM=no-reply@yourdomain.com

# SMS Service (Twilio) - Optional
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+1234567890

# Prisma Configuration - Optional
PRISMA_DISABLE_WARNINGS=true

#Cloudinary Configuration - Optional
CLOUDINARY_CLOUD_NAME=ten_cloud_cua_ban
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
